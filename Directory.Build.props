<Project>

  <!--
    Project folders are short (Web, Search, Scraping) so the solution stays readable in an IDE.
    The names that reach the outside world are derived here instead: leaving AssemblyName and
    RootNamespace to their defaults would ship Search.dll with a root namespace of Search, which
    collides with unrelated packages in a consumer's graph and is painful to diagnose.
  -->
  <PropertyGroup>
    <Product>Snail.Toolkit.Web</Product>
    <PackageId Condition="'$(MSBuildProjectName)' == 'Web'">$(Product)</PackageId>
    <PackageId Condition="'$(MSBuildProjectName)' == 'Web.Tests'">$(Product).Tests</PackageId>
    <PackageId Condition="'$(PackageId)' == ''">$(Product).$(MSBuildProjectName)</PackageId>
    <AssemblyName>$(PackageId)</AssemblyName>
    <RootNamespace>$(PackageId)</RootNamespace>
  </PropertyGroup>

  <!-- The rest of the build — language, nullable, docs, analyzers, warnings as errors — is Snail.Sdk's (global.json). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!--
    One version for every package in the repository. Independent versions only ever apply to leaves:
    packing turns a ProjectReference into a versioned dependency, so a change in the core forces the
    dependants to be republished anyway.
  -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>Toolkit</Authors>
    <Copyright>Toolkit</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/orldev/Snail.Toolkit.Web</RepositoryUrl>
    <PackageProjectUrl>https://github.com/orldev/Snail.Toolkit.Web</PackageProjectUrl>
  </PropertyGroup>

  <!--
    ONE PLACE FOR EVERYTHING THE BUILD PRODUCES, instead of bin/ and obj/ inside every project. The reason
    is not disk: the output is the same size wherever it lands, and Playwright's node driver is still copied
    beside every assembly that references it. The reason is that a source folder should contain sources. Ask
    this repository what is in src/Scraping and, without this, the answer is four folders of code and forty
    of Playwright's internals — which is what every find, grep and editor search has to wade through too.
    <para>
    ARTIFACTSPATH IS SET EXPLICITLY AND THAT IS NOT DECORATION. Left to itself the SDK puts the folder beside
    whichever Directory.Build.props was imported for the project, and this repository has four of them — src,
    tests, gen, probes. The default would therefore produce FOUR artifacts folders, which is the arrangement
    this change exists to end. <c>MSBuildThisFileDirectory</c> is read from THIS file however deep the
    importer sits, so it always names the repository root.
    </para>
  -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <!--
    No SnailPackageBaseline: nothing of this repository is on NuGet yet, so the whole public API is in
    PublicAPI.Unshipped.txt and package validation has no release to compare with. Both move with the first release.
    A PACKAGE ICON is still deliberately not done: an icon invented here would be the first piece of this project's
    identity chosen by its tooling rather than by its owner.
  -->

</Project>
