<Project>

  <Import Project="..\..\Directory.Build.props" />

  <!--
    The generator is a tool, not a package and not a test. It is in the solution for the reason the probes
    are: something that stops compiling is found at the moment it is needed, and that is the worst moment to
    repair it. Here the stakes are higher than for a probe, because CI runs this one — documentation that
    cannot be generated is documentation that silently stops matching the code.
  -->
  <!--
    Snail.Sdk knows a program that is neither packed nor documented, and whose text is data rather than prose, by
    the name *.Benchmarks; the generator is that kind of program under another name, so it says so here. Its strings
    are queries and pages in the language they are measured in, which the English-only rule leaves alone.
  -->
  <PropertyGroup>
    <SnailProjectKind>Benchmarks</SnailProjectKind>
  </PropertyGroup>

  <!--
    All six, because the reference covers all six. The project references are what put each package's
    assembly AND its generated .xml side by side in this project's output, which is the whole mechanism:
    the prose comes from the xml, and whether a type belongs in the reference comes from the assembly.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Web\Web.csproj" />
    <ProjectReference Include="..\..\src\Search\Search.csproj" />
    <ProjectReference Include="..\..\src\Scraping\Scraping.csproj" />
    <ProjectReference Include="..\..\src\Search.Browser\Search.Browser.csproj" />
    <ProjectReference Include="..\..\src\Search.Browser.Agent\Search.Browser.Agent.csproj" />
    <ProjectReference Include="..\..\src\Scraping.Agent\Scraping.Agent.csproj" />
  </ItemGroup>

</Project>
