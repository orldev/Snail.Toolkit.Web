<Project Sdk="Snail.Sdk.Library">

  <!--
    Not native, by its browser: Microsoft.Playwright 1.62 finds its driver through Assembly.Location, serializes its
    protocol with reflection and carries trim and AOT warnings of its own (the audit, 2026-10-12). This package's
    code is annotated and clean; Playwright decides.
  -->
  <PropertyGroup>
    <SnailNotNativeBecause>Microsoft.Playwright 1.62 locates its driver through Assembly.Location and serializes its protocol with reflection</SnailNotNativeBecause>
  </PropertyGroup>

  <PropertyGroup>
    <Description>
      Search providers that need a real browser, such as engines behind a consent wall or a challenge.
      Ships Brave and the base class every other such engine is written against.
    </Description>
    <PackageTags>search;playwright;browser;google</PackageTags>
  </PropertyGroup>

  <!--
    This package exists so that Snail.Toolkit.Web.Search never depends on Playwright. Without the
    split, every consumer of the search package — including one that only ever calls an HTTP provider —
    would drag in the Playwright driver it has no use for.
  -->
  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scraping\Scraping.csproj" />
    <ProjectReference Include="..\Search\Search.csproj" />
  </ItemGroup>

</Project>
