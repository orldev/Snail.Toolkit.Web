<Project Sdk="Snail.Sdk.Library">

  <!--
    Not native, by its browser: Microsoft.Playwright 1.62 finds its driver through Assembly.Location, serializes its
    protocol with reflection and carries trim and AOT warnings of its own (the audit, 2026-10-12). This package's
    code is annotated and clean; Playwright decides.
  -->
  <PropertyGroup>
    <SnailNotNativeBecause>Microsoft.Playwright 1.62 locates its driver through Assembly.Location and serializes its protocol with reflection</SnailNotNativeBecause>
  </PropertyGroup>

  <PropertyGroup>
    <Description>
      Search providers that answer only a form filled in by hand rather than a results address.
      Ships Google, which is walked through its own page by the agent.
    </Description>
    <PackageTags>search;playwright;browser;google;agent</PackageTags>
  </PropertyGroup>

  <!--
    Separate from Snail.Toolkit.Web.Search.Browser so that package keeps costing what it costs. It is
    the one a consumer takes for links alone, and the agent it would otherwise drag in is a walkthrough
    engine with its own surface. The dependency runs this way only: the light package never sees the agent.
  -->
  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scraping.Agent\Scraping.Agent.csproj" />
    <ProjectReference Include="..\Search.Browser\Search.Browser.csproj" />
  </ItemGroup>

</Project>
