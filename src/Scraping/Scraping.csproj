<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      Answers "what does this page say?" — takes a URL, drives a real browser and returns the rendered
      content or the reason there is none. Playwright is an implementation detail of this package.
    </Description>
    <PackageTags>scraping;playwright;browser;stealth;crawler</PackageTags>
  </PropertyGroup>

  <!--
    The context options are internal because which headers a browser sends is not a contract a consumer
    configures. What they must never send is, which is why the test assembly is let in rather than the type
    being made public.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Snail.Toolkit.Web.Scraping.Tests" />
  </ItemGroup>

  <!--
    The search engines are handed readers that do not repeat a refusal, under a key kept internal: which
    reading an engine gets is this toolkit's decision about its own engines, not a setting for a consumer.
    The three assemblies below are the ones that build or take those readers.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Snail.Toolkit.Web.Scraping.Agent" />
    <InternalsVisibleTo Include="Snail.Toolkit.Web.Search.Browser" />
    <InternalsVisibleTo Include="Snail.Toolkit.Web.Search.Browser.Agent" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Polly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Web\Web.csproj" />
  </ItemGroup>

</Project>
