<Project>

  <Import Project="..\Directory.Build.props" />

  <!--
    Probes are measurement tools, not a package and not a test. They are in the solution so that they
    keep compiling: a probe that rots is worse than no probe, because it is found at the moment someone
    needs a measurement and has no time to repair it.
  -->
  <!--
    Snail.Sdk knows a program that is neither packed nor documented, and whose text is data rather than prose, by
    the name *.Benchmarks; the probe is that kind of program under another name, so it says so here. Its strings
    are queries and pages in the language they are measured in, which the English-only rule leaves alone.
  -->
  <PropertyGroup>
    <SnailProjectKind>Benchmarks</SnailProjectKind>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

</Project>
